{
  "$comment": "Generated by `just generate` from pipeline/src/atlas/catalogue/models.py. Do not edit.",
  "$defs": {
    "Factor": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "default_weight": {
          "maximum": 5,
          "minimum": 0,
          "title": "Default Weight",
          "type": "integer"
        },
        "weight_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weight Reason"
        },
        "scales": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "within-city",
                  "across-cities"
                ],
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scales"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "idea",
                "researched",
                "spiked",
                "built"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "children": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Factor"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Children"
        },
        "unit": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "preference_type": {
          "anyOf": [
            {
              "enum": [
                "fixed",
                "user-direction",
                "user-range",
                "user-choice"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preference Type"
        },
        "curve": {
          "anyOf": [
            {
              "discriminator": {
                "mapping": {
                  "ideal-range": "#/$defs/IdealRange",
                  "lookup": "#/$defs/Lookup",
                  "percentile": "#/$defs/Percentile",
                  "ramp": "#/$defs/Ramp"
                },
                "propertyName": "shape"
              },
              "oneOf": [
                {
                  "$ref": "#/$defs/Ramp"
                },
                {
                  "$ref": "#/$defs/IdealRange"
                },
                {
                  "$ref": "#/$defs/Lookup"
                },
                {
                  "$ref": "#/$defs/Percentile"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curve"
        },
        "curve_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Curve Reason"
        },
        "evidence_type": {
          "anyOf": [
            {
              "enum": [
                "direct",
                "estimate",
                "indirect",
                "perception",
                "ranking"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Type"
        },
        "comparable_across_regions": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparable Across Regions"
        },
        "method": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "datasets": {
          "anyOf": [
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Datasets"
        }
      },
      "required": [
        "id",
        "name",
        "default_weight"
      ],
      "title": "Factor",
      "type": "object"
    },
    "IdealRange": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "const": "ideal-range",
          "title": "Shape",
          "type": "string"
        },
        "l0": {
          "title": "L0",
          "type": "number"
        },
        "l1": {
          "title": "L1",
          "type": "number"
        },
        "u1": {
          "title": "U1",
          "type": "number"
        },
        "u0": {
          "title": "U0",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "l0",
        "l1",
        "u1",
        "u0"
      ],
      "title": "IdealRange",
      "type": "object"
    },
    "Lookup": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "const": "lookup",
          "title": "Shape",
          "type": "string"
        },
        "scores": {
          "additionalProperties": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "minProperties": 1,
          "title": "Scores",
          "type": "object"
        }
      },
      "required": [
        "shape",
        "scores"
      ],
      "title": "Lookup",
      "type": "object"
    },
    "Percentile": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "const": "percentile",
          "title": "Shape",
          "type": "string"
        },
        "better": {
          "enum": [
            "higher",
            "lower"
          ],
          "title": "Better",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "better"
      ],
      "title": "Percentile",
      "type": "object"
    },
    "Ramp": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "const": "ramp",
          "title": "Shape",
          "type": "string"
        },
        "t0": {
          "title": "T0",
          "type": "number"
        },
        "t1": {
          "title": "T1",
          "type": "number"
        }
      },
      "required": [
        "shape",
        "t0",
        "t1"
      ],
      "title": "Ramp",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "factors": {
      "items": {
        "$ref": "#/$defs/Factor"
      },
      "minItems": 1,
      "title": "Factors",
      "type": "array"
    }
  },
  "required": [
    "factors"
  ],
  "title": "FactorsFile",
  "type": "object"
}
