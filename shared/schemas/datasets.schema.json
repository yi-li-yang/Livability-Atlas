{
  "$comment": "Generated by `just generate` from pipeline/src/atlas/catalogue/models.py. Do not edit.",
  "$defs": {
    "Dataset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "minLength": 1,
          "title": "Publisher",
          "type": "string"
        },
        "url": {
          "pattern": "^https?://\\S+$",
          "title": "Url",
          "type": "string"
        },
        "tier": {
          "enum": [
            "city",
            "country",
            "global"
          ],
          "title": "Tier",
          "type": "string"
        },
        "area": {
          "minLength": 1,
          "title": "Area",
          "type": "string"
        },
        "resolution": {
          "minLength": 1,
          "title": "Resolution",
          "type": "string"
        },
        "date": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Date"
        },
        "licence": {
          "minLength": 1,
          "title": "Licence",
          "type": "string"
        },
        "licence_checked": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence Checked"
        },
        "public_build": {
          "title": "Public Build",
          "type": "boolean"
        },
        "licence_note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence Note"
        },
        "attribution": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "tells": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Tells",
          "type": "array"
        },
        "credibility": {
          "anyOf": [
            {
              "enum": [
                "high",
                "medium",
                "low"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credibility"
        },
        "credibility_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credibility Reason"
        }
      },
      "required": [
        "id",
        "name",
        "publisher",
        "url",
        "tier",
        "area",
        "resolution",
        "date",
        "licence",
        "public_build",
        "tells"
      ],
      "title": "Dataset",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "datasets": {
      "items": {
        "$ref": "#/$defs/Dataset"
      },
      "title": "Datasets",
      "type": "array"
    }
  },
  "required": [
    "datasets"
  ],
  "title": "DatasetsFile",
  "type": "object"
}
