{
  "$comment": "Generated by `just generate` from pipeline/src/atlas/catalogue/models.py. Do not edit.",
  "$defs": {
    "Grid": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "const": "h3",
          "title": "System",
          "type": "string"
        },
        "resolution": {
          "maximum": 15,
          "minimum": 0,
          "title": "Resolution",
          "type": "integer"
        }
      },
      "required": [
        "system",
        "resolution"
      ],
      "title": "Grid",
      "type": "object"
    },
    "Place": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lng": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lng",
          "type": "number"
        }
      },
      "required": [
        "name",
        "lat",
        "lng"
      ],
      "title": "Place",
      "type": "object"
    },
    "RegionBoundary": {
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "title": "Dataset",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "name"
      ],
      "title": "RegionBoundary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A region the app can show: where it is, how it is gridded, and its default places.",
  "properties": {
    "id": {
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "country": {
      "pattern": "^[A-Z]{2}$",
      "title": "Country",
      "type": "string"
    },
    "boundary": {
      "$ref": "#/$defs/RegionBoundary"
    },
    "grid": {
      "$ref": "#/$defs/Grid"
    },
    "buffer_m": {
      "minimum": 0,
      "title": "Buffer M",
      "type": "integer"
    },
    "default_places": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Place"
      },
      "title": "Default Places",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "country",
    "boundary",
    "grid",
    "buffer_m"
  ],
  "title": "Region",
  "type": "object"
}
